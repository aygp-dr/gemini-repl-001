;; Classpath and dependencies come from deps.edn (:cljs + :dev aliases).
{:deps {:aliases [:cljs :dev]}

 :builds
 {:app
  {:target :node-script
   :output-to "target/main.js"
   :main gemini-repl.core/-main
   :devtools {:after-load gemini-repl.core/reload}}

  :test
  {:target :node-test
   :output-to "target/test.js"
   :ns-regexp "-test$"}}}
